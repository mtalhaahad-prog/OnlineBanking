@{
    ViewBag.Title = "Send Funds";
    Layout = "~/Views/Shared/_UserLayout.cshtml";

    var myAccounts = ViewBag.MyAccounts as List<OnlineBanking.Models.BankAccount>;
    var beneficiaries = ViewBag.Beneficiaries as List<OnlineBanking.Models.Beneficiary>;
}

<div class="sidebar-space"></div>

<div class="content">
    <!-- Header -->
    <div class="dashboard-header">
        <h2><i class="fas fa-exchange-alt"></i> Send Funds</h2>
        <p>Transfer money to your own accounts or other beneficiaries</p>
    </div>

    @if (TempData["TransferSuccess"] != null)
    {
        <div class="alert alert-success">
            <i class="fas fa-check-circle"></i> @TempData["TransferSuccess"]
        </div>
    }
    @if (TempData["TransferError"] != null)
    {
        <div class="alert alert-danger">
            <i class="fas fa-exclamation-circle"></i> @TempData["TransferError"]
        </div>
    }

    <!-- Alert -->
    <div class="alert alert-info">
        <i class="fas fa-info-circle"></i>
        Transfer charges may apply. Please review the amount before confirming.
    </div>

    <!-- Transfer Form -->
    <div class="form-card">
        <h3>New Transfer</h3>
        <form method="post" action="@Url.Action("Transfer","Users")">
            @Html.AntiForgeryToken()

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;">
                <div class="form-group">
                    <label for="fromAccountId" class="form-label">From Account *</label>
                    <select class="form-select" name="fromAccountId" id="fromAccountId" required>
                        <option value="">-- Select Account --</option>
                        @if (myAccounts != null)
                        {
                            foreach (var acc in myAccounts)
                            {
                                <option value="@acc.AccountID">@acc.AccountType (@acc.AccountNumber) — @acc.Currency @acc.AvailableBalance.ToString("N0")</option>
                            }
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label for="toValue" class="form-label">
                        To Account *
                        <a href="#" onclick="openAddBeneficiary(); return false;" style="font-size: 0.85rem; margin-left: 0.5rem;">
                            <i class="fas fa-plus-circle"></i> Add Beneficiary
                        </a>
                    </label>
                    <select class="form-select" name="toValue" id="toValue" required onchange="updateToType(this)">
                        <option value="">-- Select Account --</option>
                        @if (myAccounts != null && myAccounts.Count > 1)
                        {
                            <optgroup label="My Other Accounts">
                                @foreach (var acc in myAccounts)
                                {
                                    <option value="@acc.AccountID" data-type="own">@acc.AccountType (@acc.AccountNumber)</option>
                                }
                            </optgroup>
                        }
                        @if (beneficiaries != null && beneficiaries.Any())
                        {
                            <optgroup label="Beneficiaries">
                                @foreach (var b in beneficiaries)
                                {
                                    <option value="@b.BeneficiaryID" data-type="beneficiary">@b.BeneficiaryName (@b.BeneficiaryAccountNumber)</option>
                                }
                            </optgroup>
                        }
                        <optgroup label="Other">
                            <option value="manual" data-type="manual">Enter Account Number Manually</option>
                        </optgroup>
                    </select>
                    <input type="hidden" name="toType" id="toType" value="" />
                </div>
            </div>

            <div class="form-group" id="manualAccountGroup" style="display: none;">
                <label for="manualAccountNumber" class="form-label">Recipient Account Number *</label>
                <input type="text" class="form-control" name="manualAccountNumber" id="manualAccountNumber" placeholder="Enter account number">
            </div>

            <div class="form-group">
                <label for="amount" class="form-label">Amount *</label>
                <input type="number" step="0.01" min="1" class="form-control" name="amount" id="amount" placeholder="Enter amount" required>
            </div>

            <div class="form-group">
                <label for="description" class="form-label">Description (Optional)</label>
                <textarea class="form-control" name="description" id="description" rows="2" placeholder="Add a note..."></textarea>
            </div>

            <div style="display: flex; gap: 1rem;">
                <button type="submit" class="btn btn-primary-gold">
                    <i class="fas fa-arrow-right"></i> Send Funds
                </button>
                <button type="reset" class="btn btn-secondary-outline" onclick="resetManualField()">
                    <i class="fas fa-redo"></i> Clear
                </button>
            </div>
        </form>
    </div>

    <!-- Add Beneficiary modal -->
    <div id="addBeneficiaryModal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:999;">
        <div style="background:#fff; max-width:420px; margin:100px auto; padding:20px; border-radius:8px;">
            <h3>Add Beneficiary</h3>
            <form method="post" action="@Url.Action("AddBeneficiary","Users")">
                @Html.AntiForgeryToken()

                <label>Beneficiary Name *</label>
                <input type="text" name="beneficiaryName" class="form-control mb-2" required />

                <label>Account Number *</label>
                <input type="text" name="beneficiaryAccountNumber" class="form-control mb-2" placeholder="e.g. ACC-0001-1001" required />

                <label>Relationship (Optional)</label>
                <input type="text" name="relationship" class="form-control mb-3" placeholder="e.g. Friend, Family" />

                <button type="submit" class="btn btn-primary-gold mb-2">Save</button>
                <button type="button" class="btn btn-secondary mb-2" onclick="closeAddBeneficiary()">Cancel</button>
            </form>
        </div>
    </div>
</div>

<script>
    function updateToType(select) {
        var selectedOption = select.options[select.selectedIndex];
        var type = selectedOption.getAttribute('data-type') || '';
        document.getElementById('toType').value = type;

        var manualGroup = document.getElementById('manualAccountGroup');
        var manualInput = document.getElementById('manualAccountNumber');

        if (type === 'manual') {
            manualGroup.style.display = 'block';
            manualInput.required = true;
        } else {
            manualGroup.style.display = 'none';
            manualInput.required = false;
        }
    }

    function resetManualField() {
        document.getElementById('manualAccountGroup').style.display = 'none';
        document.getElementById('toType').value = '';
    }

    function openAddBeneficiary() {
        document.getElementById('addBeneficiaryModal').style.display = 'block';
    }

    function closeAddBeneficiary() {
        document.getElementById('addBeneficiaryModal').style.display = 'none';
    }
</script>